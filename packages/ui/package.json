{
  "name": "@outbound/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles/globals.css": "./src/styles/globals.css",
    "./lib/utils": "./src/lib/utils.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "files": [
    "src",
    "components.json"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests in packages/ui yet'"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.16.0",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@outbound/eslint-config": "workspace:*",
    "@outbound/typescript-config": "workspace:*",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  }
}
