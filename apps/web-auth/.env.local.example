# Outbound Spotter — web-auth local environment.
# Copy to `.env.local` and fill in. Validated via src/config/env.ts (zod).

# Clerk publishable key (per environment). https://clerk.com/docs/quickstarts/setup-clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Where to send the user after sign-in / sign-up. Should match the web-app dev port.
VITE_APP_URL=http://localhost:5173

# Surfaced in error UIs ("Need help?"). Override per environment if needed.
VITE_SUPPORT_EMAIL=support@outboundspotter.com
