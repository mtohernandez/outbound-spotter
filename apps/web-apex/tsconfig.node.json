{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@outbound/typescript-config/base",
  "compilerOptions": {
    "tsBuildInfoFile": "${configDir}/node_modules/.cache/tsbuildinfo.node.json",
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client"],
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "${configDir}/node_modules/.cache/tsc-node"
  },
  "include": ["vite.config.ts"]
}
