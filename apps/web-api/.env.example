# Outbound Spotter — web-api environment variables.
# Copy to `.env` and fill in. Validated via web_api/settings/base.py (pydantic-settings).

DEBUG=true
SECRET_KEY=dev-insecure-key-replace-in-prod
ALLOWED_HOSTS=["localhost","127.0.0.1"]

DATABASE_URL=postgresql://outbound:outbound@localhost:5432/outbound_dev

CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Clerk (get from clerk.com dashboard). The web-api verifies JWTs against the issuer's JWKS.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=

# OpenRouteService — driving-hgv profile + Pelias geocoding. Server-side only.
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
