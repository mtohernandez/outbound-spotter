# Outbound Spotter — web-app environment variables.
# Copy to `.env.local` and fill in. Validated via src/config/env.ts (zod).

# Base URL for the Django web-api service.
VITE_API_URL=http://localhost:8000

# Clerk publishable key (per-environment). Get from clerk.com dashboard.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Auth host — points at web-auth in dev. Production: auth.outbound-spotter.<host>
VITE_AUTH_SIGN_IN_URL=http://localhost:5174/sign-in
VITE_AUTH_SIGN_UP_URL=http://localhost:5174/sign-up
