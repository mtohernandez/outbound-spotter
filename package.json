{
  "name": "outbound-spotter",
  "private": true,
  "version": "0.0.0",
  "description": "HOS-compliant trip-planning monorepo (web-app + web-auth + web-api).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "py:lint": "uvx ruff check apps/web-api",
    "py:format": "uvx ruff format apps/web-api",
    "py:typecheck": "echo \"web-api not scaffolded yet; mypy runs once apps/web-api/pyproject.toml lands\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@outbound/eslint-config": "workspace:*",
    "@outbound/typescript-config": "workspace:*",
    "@types/node": "25.9.0",
    "eslint": "10.4.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "turbo": "2.9.14",
    "typescript": "6.0.3"
  }
}
